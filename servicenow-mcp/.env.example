SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password 
# Chat agent (scripts/chat_api.py). Leave ANTHROPIC_API_KEY empty to use the Claude
# (Pro/Max) login on this machine with no per-token billing; set it only for a server
# deployment. Never copy any of these into the frontend.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
CHAT_EFFORT=medium
CHAT_TOOL_PACKAGE=chat_readonly
